# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real credentials!

DB_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=verify-full&channelBinding=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DDL_AUTO=validate

# Spring Boot loads .env when started from icrowd_api. Do not quote values.
FRONTEND_URL=http://localhost:5173
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
# Merchant API credentials for automatic payment verification and refunds.
# Without these, unresolved payments require an administrator's merchant review.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Gmail App Password, not the normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_API_URL=http://localhost:8080
MARKETING_ENABLED=false
MARKETING_DAILY_LIMIT=100
MARKETING_WEEKLY_CUSTOMER_LIMIT=2

# Generate a unique random signing secret (at least 32 bytes); no default exists.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use an https PUBLIC_API_URL to send subscription confirmation links.
# For one-time first-admin provisioning only, enable the bootstrap-admin profile:
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Configure the trusted PostgreSQL CA for verify-full before connecting.
