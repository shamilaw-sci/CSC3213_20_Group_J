# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real credentials!

DB_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require&channel_binding=require
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DDL_AUTO=update

# Spring Boot loads .env when started from icrowd_api. Do not quote values.
FRONTEND_URL=http://localhost:5173
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_NOTIFY_URL=
# Optional Merchant API credentials for automatic refunds
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
