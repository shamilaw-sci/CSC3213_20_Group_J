# --- Frontend Specific ---
iCrowd_UI/node_modules/
iCrowd_UI/dist/

# --- Java Backend Specific (Maven/Gradle) ---
icrowd_api/target/
icrowd_api/bin/
icrowd_api/.settings/
icrowd_api/.metadata/
icrowd_api/uploads/
*.class
*.jar

# --- System & IDE Junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Security (The most important part!) ---
.env
.env.local
icrowd_api/.env
/local-backups/

# Runtime output and private local diagnostics (never source code)
*.log
*.hprof
*.jfr
*.dmp
replay_pid*
**/untracked_backup/

# Local environment variants; retain safe configuration examples
.env.*
!.env.example
!.env.sample

# Raw one-off audit output; retain reports and reproducible check scripts
/docs/audit-2026-11-15/*.txt
/docs/audit-2026-11-15/*.json
